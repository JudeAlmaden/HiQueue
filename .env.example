# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Choose ONE setup below and uncomment it. Comment out the others.
# After changing, run: npm run prisma:generate && npm run prisma:migrate
# =============================================================================
# D:\Projects\HiQueue\prisma\schema\base.prisma
# You may need to update 

# -----------------------------------------------------------------------------
# OPTION 1: SQLite (Local Development - DEFAULT)
# -----------------------------------------------------------------------------
# Simplest setup - no installation required, file-based database
# Perfect for: Local development, testing, prototyping
# Limitations: Single user, no concurrent writes, not for production

DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"

# No additional setup needed for SQLite!
# Just run: npm run prisma:migrate


# -----------------------------------------------------------------------------
# OPTION 2: Supabase (PostgreSQL Cloud - RECOMMENDED FOR PRODUCTION)
# -----------------------------------------------------------------------------
# Managed PostgreSQL with built-in auth, real-time, and storage
# Perfect for: Production deployments, scalable applications
# Get started: https://supabase.com (free tier available)

# DATABASE_PROVIDER="postgresql"
# 
# # Connection Pooling URL (for application - use this in production)
# # Get from: Supabase Dashboard → Settings → Database → Connection Pooling
# DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# 
# # Direct Connection URL (required for migrations)
# # Get from: Supabase Dashboard → Settings → Database → Connection String
# DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
#
# Setup steps:
# 1. Create project at https://supabase.com
# 2. Go to Settings → Database
# 3. Copy "Connection Pooling" string to DATABASE_URL
# 4. Copy "Connection String" to DIRECT_DATABASE_URL
# 5. Replace [YOUR-PASSWORD] with your database password
# 6. Run: npm run prisma:generate && npm run prisma:migrate
#
# See: Documentation/SUPABASE_QUICKSTART.md


# -----------------------------------------------------------------------------
# OPTION 3: MySQL (Self-Hosted or Cloud)
# -----------------------------------------------------------------------------
# Popular open-source database, widely supported
# Perfect for: Existing MySQL infrastructure, shared hosting
# Options: Local MySQL, PlanetScale, AWS RDS, DigitalOcean

# DATABASE_PROVIDER="mysql"
# 
# # Local MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/hiqueue"
# 
# # PlanetScale (Serverless MySQL):
# # DATABASE_URL="mysql://username:password@aws.connect.psdb.cloud/hiqueue?sslaccept=strict"
# 
# # AWS RDS MySQL:
# # DATABASE_URL="mysql://admin:password@hiqueue.abc123.us-east-1.rds.amazonaws.com:3306/hiqueue"
#
# Setup steps:
# 1. Install MySQL locally OR create cloud database
# 2. Create database: CREATE DATABASE hiqueue;
# 3. Update connection string with your credentials
# 4. Run: npm run prisma:generate && npm run prisma:migrate


# -----------------------------------------------------------------------------
# OPTION 4: PostgreSQL (Self-Hosted)
# -----------------------------------------------------------------------------
# Powerful open-source database with advanced features
# Perfect for: Self-hosted production, complex queries, JSON support

# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://username:password@localhost:5432/hiqueue?schema=public"
# 
# # Optional: Direct URL for migrations (same as DATABASE_URL if no pooling)
# DIRECT_DATABASE_URL="postgresql://username:password@localhost:5432/hiqueue?schema=public"
#
# Setup steps:
# 1. Install PostgreSQL locally OR use cloud provider
# 2. Create database: createdb hiqueue
# 3. Update connection string with your credentials
# 4. Run: npm run prisma:generate && npm run prisma:migrate

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Auth Secret - Generate a random string for production
# Use: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"

# NextAuth URL - Required for OAuth callbacks and production deployments
# Development (default): http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# Trust host for NextAuth (required when using trustHost in auth.config.ts)
AUTH_TRUST_HOST="true"

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# =============================================================================
# OPTIONAL: DATABASE CONNECTION POOLING (Production)
# =============================================================================

# Enable connection pooling for better performance with PostgreSQL
# Requires PgBouncer or Prisma Data Platform
# DIRECT_DATABASE_URL="postgresql://username:password@localhost:5432/hiqueue"
# DATABASE_URL="postgresql://username:password@pgbouncer:6432/hiqueue?pgbouncer=true"

# =============================================================================
# OPTIONAL: SHADOW DATABASE (For safe migrations in production)
# =============================================================================

# A separate database used by Prisma Migrate to detect schema drift
# Required for cloud databases that don't allow schema comparison
# SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/hiqueue_shadow"

# =============================================================================
# OPTIONAL: APPLICATION CONFIGURATION
# =============================================================================

# App Name (for branding, page titles, etc.)
# APP_NAME="HiQueue"

# Node Environment
# NODE_ENV="development"

# =============================================================================
# OPTIONAL: FILE STORAGE (For future logo uploads)
# =============================================================================

# AWS S3 (for production file storage)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="hiqueue-uploads"

# Cloudinary (alternative to S3)
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
