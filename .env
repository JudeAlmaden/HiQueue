# =============================================================================
# DATABASE CONFIGURATION - SUPABASE
# =============================================================================

# Database Provider: Use "postgresql" for Supabase
DATABASE_PROVIDER="sqlite"

# Supabase Connection String (Pooled - Recommended for application)
# Get this from: Supabase Dashboard → Settings → Database → Connection Pooling
# Format: postgresql://postgres.PROJECT-REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="file:./dev.db"

# Direct Connection (Required for migrations)
# Get this from: Supabase Dashboard → Settings → Database → Connection String
# Format: postgresql://postgres:[PASSWORD]@db.PROJECT-REF.supabase.co:5432/postgres
DIRECT_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# Instructions:
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Settings → Database
# 3. Copy "Connection Pooling" string to DATABASE_URL
# 4. Copy "Connection String" to DIRECT_DATABASE_URL
# 5. Replace [YOUR-PASSWORD] with your actual database password
# 6. Replace YOUR-PROJECT-REF with your project reference
# 7. Update region (aws-0-us-east-1) if different
#
# Need help? See Documentation/SUPABASE_SETUP.md

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Auth Secret - Generate a random string for production
# Generate with: openssl rand -base64 32
AUTH_SECRET="secret"